# =====================================================================
#  Configuración del entorno DWES
#
#  Credenciales COMUNES a toda la clase: no las cambies. Así cualquier
#  proyecto funciona igual en tu equipo, en el de tus compañeros y en el
#  del profesor cuando lo corrija.
#
#  Lo único que puedes tocar son los PUERTOS si alguno está ocupado.
#  Después de cambiar un puerto: docker compose up -d
# =====================================================================

# ---- Puertos en tu equipo (cámbialos solo si están ocupados) ----
WEB_PORT=8080
PMA_PORT=8081
MYSQL_PORT=3307

# ---- Base de datos (NO CAMBIAR) ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=dwes
MYSQL_USER=dwes
MYSQL_PASSWORD=dwes

# ---- Depuración con Xdebug ----
# off = desactivado (por defecto) | debug = depuración paso a paso con VS Code
# Después de cambiarlo: docker compose up -d
XDEBUG_MODE=off

# ---- Solo Linux: tu UID y GID (comando: id -u ; id -g) ----
# En Windows y macOS no hace falta tocarlo.
UID=1000
GID=1000
